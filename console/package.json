{
  "name": "aws-emulator-console",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.18.3",
  "engines": { "node": ">=24" },
  "scripts": {
    "refs:fetch": "node scripts/fetch-refs.mjs",
    "catalog:build": "node packages/catalog-compiler/src/cli.ts build",
    "catalog:check": "node packages/catalog-compiler/src/cli.ts check",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p packages/model/tsconfig.json",
    "test": "vitest run"
  },
  "pnpm": { "onlyBuiltDependencies": ["esbuild"] },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "eslint": "^9.39.5",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.73.0",
    "vitest": "^3.2.7"
  }
}
